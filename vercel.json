{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/reports/KOPANO_LABS.pdf",
      "destination": "https://drive.google.com/uc?export=download&id=1lEiP-W7eIRES9D5KyrP-U4gwizYLyKOh"
    },
    { "source": "/Cars4Mars/:path*", "destination": "/index.html" },
    { "source": "/((?!robots.txt|sitemap.xml|release.json|humans.txt|reports/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/reports/KOPANO_LABS.pdf",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
