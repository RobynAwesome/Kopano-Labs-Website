{
  "name": "kopano-labs-website",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "crawl:generate": "node scripts/generate-crawl-policy.mjs",
    "routes:generate": "node scripts/generate-route-shells.mjs",
    "convergence:verify": "node scripts/verify-convergence.mjs",
    "build": "npm run crawl:generate && tsc -b && vite build && npm run routes:generate && npm run convergence:verify",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@vitejs/plugin-react": "^6.0.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.184.0",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "typescript": "7.0.2"
  }
}
