{
  "name": "kopano-labs-website",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "predev": "npm run experiments:sync && npm run evidence:sync",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "crawl:generate": "node scripts/generate-crawl-policy.mjs",
    "crawl:verify": "node scripts/verify-crawl-policy.mjs",
    "routes:generate": "node scripts/generate-route-shells.mjs",
    "convergence:verify": "node scripts/verify-convergence.mjs",
    "experiments:sync": "node scripts/sync-sovereign-experiments.mjs",
    "experiments:verify": "node scripts/verify-governed-experiments.mjs",
    "evidence:sync": "node scripts/sync-public-evidence.mjs",
    "evidence:verify": "node scripts/verify-public-evidence.mjs",
    "poc:verify": "node scripts/verify-cars4mars-poc.mjs",
    "player:verify": "node scripts/verify-adaptive-player-poc.mjs",
    "build": "npm run assets:verify && npm run experiments:sync && npm run experiments:verify && npm run evidence:sync && npm run evidence:verify && npm run crawl:generate && npm run crawl:verify && tsc -b && vite build && npm run routes:generate && npm run convergence:verify && npm run poc:verify && npm run player:verify",
    "preview": "vite preview",
    "assets:verify": "node scripts/verify-public-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@vitejs/plugin-react": "^6.0.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.184.0",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "typescript": "7.0.2"
  }
}
